+void mk_fox_finder(mk_tracker_finder_t* out)
+{
+    if (!out) return;
+    memset(out, 0, sizeof(*out));
+    const TrackerFinder& f = s_fox.finder();
+    FoxTarget t{};
+    if (!f.hasTarget() || !s_fox.finder_target(t)) return;
+
+    const uint32_t now = millis();
+    const bool run = s_fox.running();
+    out->has_target = 1;
+    switch (f.state(now, run)) {
+        case TrackerFinder::State::Live:    out->state = MK_TRK_LIVE;    break;
+        case TrackerFinder::State::Waiting: out->state = MK_TRK_WAITING; break;
+        case TrackerFinder::State::Lost:    out->state = MK_TRK_LOST;    break;
+        default:                            out->state = MK_TRK_PAUSED;  break;
+    }
+    int dir = 0;
+    out->trend_ready   = f.trend(now, run, dir) ? 1 : 0;
+    out->trend         = (int8_t)dir;
+    out->strength      = (int16_t)f.strength();
+    out->filtered_rssi = t.filtered_rssi;
+    out->age_ms        = f.age(now);
+    out->target_id     = t.id;
+    memcpy(out->mac, t.mac, 6);
+    out->type       = t.kind;
+    out->scan_fresh = t.scan_fresh ? 1 : 0;
+
+    unsigned hc = f.historyCount();
+    if (hc > MK_TRK_HISTORY) hc = MK_TRK_HISTORY;
+    out->history_count = (uint16_t)hc;
+    for (unsigned i = 0; i < hc; i++) out->history[i] = f.history(i);
+}
